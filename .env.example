# Log
LOG_FORMAT=text
LOG_LEVEL=info

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_PUBLIC_URL=http://localhost:8080
LINK_TOKEN_LIFETIME=15m
LINK_COOKIE_LIFETIME=10m

# Postgres
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arbiterer
POSTGRES_SSLMODE=disable

# Create an app at https://discord.com/developers/applications and add a
# redirect to the `DISCORD_REDIRECT_URI` below under "OAuth2 -> Redirects".
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=http://localhost:8080/v1/link/discord/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=http://localhost:8080/v1/link/github/callback
GITHUB_OIDC_AUDIENCE=
